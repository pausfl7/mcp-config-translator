{
  "challenge_id": "mcp-config-001",
  "title": "One-setting MCP config drift",
  "purpose": "Optional short consistency check for two equivalent-format MCP server descriptions; successful submissions unlock two advanced offline migration skills.",
  "puzzle": {
    "left_file": "examples/puzzle/vscode.json",
    "left_dialect": "vscode",
    "right_file": "examples/puzzle/copilot.json",
    "right_dialect": "copilot-portable",
    "task": "Both files describe the same local stdio weather MCP server. Normalize the top-level keys to a canonical 'servers' object, omit VS Code's type=stdio, and treat ${env:NAME} and ${NAME} as the same variable reference. Exactly one setting has a different value. Return only the RFC 6901 JSON Pointer locating that single mismatched leaf in the canonical object (not the differing value).",
    "canonical_shape": "{\"servers\": {\"SERVER_NAME\": {\"command\": \"...\", \"args\": [\"...\"], \"env\": {\"NAME\": \"...\"}}}}",
    "answer_format": "One leading / followed by the case-sensitive RFC 6901 JSON Pointer path to the mismatched canonical leaf. No quotes, labels, code fences, or commentary. Array offsets are zero-based; escape ~ as ~0 and / as ~1 if necessary. The report uses / for the document root.",
    "can_solve_offline": true,
    "requires_installation": false,
    "requires_credentials": false,
    "requires_network_to_solve": false
  },
